# Server-only variables. Never prefix secrets with NEXT_PUBLIC_.

# Required for live GitHub contribution data.
# Use a fine-grained personal access token with public repository read access.
# Leave empty to develop the studio using sample data.
GITHUB_TOKEN=

# Canonical production URL for published links and page metadata.
# Required on Vercel for Production and Preview.
# Leave empty locally to use the request host.
SITE_URL=

# E2E test overrides. Do not configure these on Vercel.
# GITVIS_DATA_TTL_SECONDS=
# GITVIS_MAX_STALE_SECONDS=
# GITVIS_GITHUB_GRAPHQL_URL=
# GITVIS_GITLAB_ORIGIN=
