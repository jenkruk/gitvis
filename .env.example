# Server-only. Never prefix with NEXT_PUBLIC_. See docs/DEPLOYMENT.md for per-environment guidance.

# Required. Fine-grained PAT (ideally from a dedicated bot account): Public repositories read-only, no permissions.
GITHUB_TOKEN=

# Required on Vercel (Production AND Preview): canonical production origin for published Markdown and Edit links,
# e.g. https://gitvis.example. Locally it can stay empty (the request host is used).
SITE_URL=

# Test-only (E2E): never set these on Vercel. Ignored when VERCEL_ENV=production.
# GITVIS_DATA_TTL_SECONDS=
# GITVIS_MAX_STALE_SECONDS=
# GITVIS_GITHUB_GRAPHQL_URL=
# GITVIS_GITLAB_ORIGIN=
