# Server-only. Never prefix with NEXT_PUBLIC_.
# Phase 2: fine-grained PAT from a dedicated machine-user account, public read-only, no extra permissions.
GITHUB_TOKEN=
# Optional. Enables GitLab GraphQL contributionCalendar (experimental); calendar.json is used otherwise.
GITLAB_TOKEN=
# Production: canonical origin used in published Markdown and Edit links (e.g. https://gitvis.example).
SITE_URL=
